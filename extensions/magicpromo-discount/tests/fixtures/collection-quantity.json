{
  "payload": {
    "export": "cart-lines-discounts-generate-run",
    "target": "cart.lines.discounts.generate.run",
    "input": {
      "cart": {
        "lines": [
          {
            "id": "gid://shopify/CartLine/1",
            "quantity": 3,
            "merchandise": {
              "__typename": "ProductVariant",
              "product": {
                "id": "gid://shopify/Product/1",
                "inAnyCollection": true
              }
            }
          }
        ]
      },
      "discount": {
        "discountClasses": [
          "PRODUCT"
        ],
        "metafield": {
          "jsonValue": {
            "version": 1,
            "productIds": [],
            "discountPercent": 15,
            "minimumProducts": 3,
            "qualificationMode": "total_quantity",
            "collectionIds": [
              "gid://shopify/Collection/1"
            ]
          }
        }
      }
    },
    "output": {
      "operations": [
        {
          "productDiscountsAdd": {
            "candidates": [
              {
                "message": "15% off eligible products",
                "targets": [
                  {
                    "cartLine": {
                      "id": "gid://shopify/CartLine/1"
                    }
                  }
                ],
                "value": {
                  "percentage": {
                    "value": "15"
                  }
                }
              }
            ],
            "selectionStrategy": "FIRST"
          }
        }
      ]
    }
  }
}
